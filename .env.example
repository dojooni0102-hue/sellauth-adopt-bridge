# ==========================================
# SellAuth 업자 및 상점 설정 파일
# ==========================================

# 1. 업자 SellAuth 상점 서브도메인 또는 URL (예: supplier.sellauth.com 이면 'supplier')
SUPPLIER_SHOP_DOMAIN=supplier_domain_here

# 2. 업자 상점 Shop ID (숫자) - 모를 경우 공란 가능
SUPPLIER_SHOP_ID=

# 3. 업자에게 발급받은 API 키 (있을 경우)
SUPPLIER_API_KEY=your_supplier_api_key_here

# 4. 결제 시 사용할 내 이메일 (업자 샵에서 구매 영수증을 수신할 이메일)
MY_BUYER_EMAIL=ryudongsoo@gmail.com

# 5. 테스트 모드 (True면 실제 업자 결제 없이 가짜 계정 반환하여 연동 테스트)
TEST_MODE=False
